---
import StatusBadge from './ui/StatusBadge.astro';
import StatusIcon from './ui/StatusIcon.astro';
import Icon from './ui/Icon.astro';
import TimelineMarker from './ui/TimelineMarker.astro';
import { regions, monitors, incident } from '../data/content';

/* ---- Gráfico de barras: latência p95 por hora e região (ilustrativo, determinístico) ---- */
const HOURS = 24;
const MAX = 800;
let seed = 11;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const base: Record<string, number> = { gru: 62, iad: 158, fra: 232 };

const groups = Array.from({ length: HOURS }, (_, h) => ({
  hour: h,
  bars: regions.map((r) => {
    const noise = Math.sin(h / 3) * 10 + (rand() - 0.5) * 30;
    const spike = h >= 21 ? (h - 20) * 120 : 0;
    const v = Math.max(24, base[r.id] + noise + spike);
    return { color: r.color, pct: Math.min(100, (v / MAX) * 100).toFixed(1), v: Math.round(v) };
  }),
}));
const last = groups[HOURS - 1].bars;
const yTicks = [800, 600, 400, 200, 0];
const thresholdPct = (500 / MAX) * 100;

const kpis = [
  { label: 'Disponibilidade 30d', value: '99,87%', note: 'meta 99,9%', status: 'degraded' as const },
  { label: 'Latência p95', value: '214 ms', note: 'média 24h, 3 regiões' },
  { label: 'Incidentes abertos', value: '1', note: 'há 6 min', status: 'down' as const },
  { label: 'Erros novos hoje', value: '3', note: '2 no checkout' },
];

const nav = [
  { label: 'Monitores', icon: 'activity', active: true },
  { label: 'Incidentes', icon: 'bell', badge: '1' },
  { label: 'Logs', icon: 'terminal' },
  { label: 'Erros', icon: 'bug' },
  { label: 'Página de status', icon: 'page' },
  { label: 'Plantão', icon: 'clock' },
];

---
<div
  class="dash card"
  role="img"
  aria-label="Exemplo do painel do Pulso: quatro monitores, um fora do ar e um lento, gráfico de latência por região nas últimas 24 horas e a linha do tempo do incidente."
>
  <aside class="dash__side" aria-hidden="true">
    <div class="dash__project">
      <span class="dash__avatar">L</span>
      <div>
        <span class="dash__project-name">Loja</span>
        <span class="dash__env">produção</span>
      </div>
    </div>
    <ul class="dash__nav">
      {nav.map((n) => (
        <li class:list={[{ 'is-active': n.active }]}>
          <Icon name={n.icon} size={16} />
          <span>{n.label}</span>
          {n.badge && <span class="dash__nav-badge">{n.badge}</span>}
        </li>
      ))}
    </ul>
  </aside>

  <div class="dash__main" aria-hidden="true">
    <div class="dash__bar">
      <div class="dash__title">
        <Icon name="activity" size={18} class="accent" />
        <span>Monitores</span>
      </div>
      <div class="dash__range">
        <span>1h</span><span class="is-active">24h</span><span>7d</span><span>30d</span>
      </div>
    </div>

    <div class="dash__kpis">
      {kpis.map((k) => (
        <div class="kpi">
          <span class="kpi__label">{k.label}</span>
          <span class="kpi__value">{k.value}</span>
          <span class="kpi__note">
            {k.status && <StatusIcon status={k.status} size={12} />}
            {k.note}
          </span>
        </div>
      ))}
    </div>

    <div class="dash__grid">
      <div class="panel">
        <div class="panel__head">
          <span class="panel__title">Latência p95 do checkout por região</span>
          <ul class="legend">
            {regions.map((r, i) => (
              <li>
                <span class="legend__swatch" style={`background:${r.color}`}></span>
                {r.short} <b>{last[i].v} ms</b>
              </li>
            ))}
          </ul>
        </div>
        <div class="chart">
          <div class="chart__y">
            {yTicks.map((t) => <span>{t}</span>)}
          </div>
          <div class="chart__plot">
            {yTicks.map((_, i) => <span class="chart__grid" style={`top:${i * 25}%`}></span>)}
            <span class="chart__limit" style={`bottom:${thresholdPct}%`}><em>limite 500 ms</em></span>
            <div class="chart__bars">
              {groups.map((g) => (
                <div class="chart__group">
                  {g.bars.map((b) => <i style={`height:${b.pct}%;background:${b.color}`}></i>)}
                </div>
              ))}
            </div>
          </div>
          <div class="chart__x">
            <span>00h</span><span>06h</span><span>12h</span><span>18h</span><span>agora</span>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel__head panel__head--stack">
          <StatusBadge status="down" label="Incidente" />
          <span class="panel__title">{incident.title}</span>
        </div>
        <ol class="tl">
          {incident.events.slice(0, 5).map((e) => (
            <li class="tl__item">
              <span class="tl__dot"><TimelineMarker kind={e.kind} size={12} /></span>
              <span class="tl__time">{e.time}</span>
              <span class="tl__what">{e.title}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="panel panel--flush">
      <div class="table-scroll">
        <table class="mon">
          <thead>
            <tr>
              <th scope="col">Monitor</th>
              <th scope="col">Status</th>
              <th scope="col">Últimos 45 dias</th>
              <th scope="col" class="num">30d</th>
              <th scope="col" class="num">p95</th>
            </tr>
          </thead>
          <tbody>
            {monitors.map((m) => (
              <tr>
                <td>
                  <span class="mon__name">{m.name}</span>
                  <span class="mon__url">{m.url}</span>
                </td>
                <td><StatusBadge status={m.status} /></td>
                <td>
                  <span class="bars">
                    {m.history.map((s) => <i class={`bar bar--${s}`} />)}
                  </span>
                </td>
                <td class="num">{m.uptime}</td>
                <td class="num">{m.p95}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<style>
  .dash {
    display: grid;
    grid-template-columns: 208px minmax(0, 1fr);
    overflow: hidden;
    font-size: 13px;
    letter-spacing: 0;
    text-align: left;
    background: var(--color-pure-black);
    border-color: var(--color-slate-edge);
  }
  .dash :global(.accent) { color: var(--color-soft-indigo); }

  .dash__side {
    padding: 16px 12px;
    border-right: 1px solid var(--color-iron);
    background: var(--color-carbon);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .dash__project { display: flex; align-items: center; gap: 10px; padding: 4px 8px; }
  .dash__avatar {
    width: 28px; height: 28px; display: grid; place-items: center;
    border-radius: 6px; background: var(--color-iron); font-weight: 600; font-size: 13px;
  }
  .dash__project-name { display: block; font-weight: 500; font-size: 14px; }
  .dash__env { display: block; font-family: var(--font-mono); font-size: 11px; color: var(--color-ash); }
  .dash__nav { display: flex; flex-direction: column; gap: 2px; }
  .dash__nav li {
    display: flex; align-items: center; gap: 10px;
    padding: 8px; border-radius: 6px; color: var(--color-ash);
  }
  .dash__nav li span:nth-of-type(1) { flex: 1; }
  .dash__nav li.is-active { background: var(--color-iron); color: var(--color-bone); }
  .dash__nav-badge {
    min-width: 18px; height: 18px; padding: 0 5px; display: inline-grid; place-items: center;
    border-radius: 4px; background: var(--color-slate-edge); color: var(--color-bone);
    font-family: var(--font-mono); font-size: 11px;
  }

  .dash__main { padding: 16px; display: flex; flex-direction: column; gap: 12px; min-width: 0; background: var(--color-carbon); }
  .dash__bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding-bottom: 4px; }
  .dash__title { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 500; }
  .dash__range { display: flex; padding: 2px; border: 1px solid var(--color-iron); border-radius: 6px; background: var(--color-graphite); }
  .dash__range span { padding: 4px 10px; border-radius: 4px; color: var(--color-ash); font-family: var(--font-mono); font-size: 11px; }
  .dash__range .is-active { background: var(--color-iron); color: var(--color-bone); }

  .dash__kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .kpi { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; background: var(--color-graphite); border: 1px solid var(--color-iron); border-radius: 8px; }
  .kpi__label { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ash); }
  .kpi__value { font-size: 24px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }
  .kpi__note { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--color-ash); }

  .dash__grid { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr); gap: 8px; }
  .panel { padding: 14px; background: var(--color-graphite); border: 1px solid var(--color-iron); border-radius: 8px; min-width: 0; }
  .panel--flush { padding: 4px 0 0; }
  .panel__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .panel__head--stack { flex-direction: column; gap: 8px; }
  .panel__title { font-weight: 500; font-size: 13px; }
  .legend { display: flex; gap: 14px; flex-wrap: wrap; font-family: var(--font-mono); font-size: 11px; color: var(--color-ash); }
  .legend li { display: inline-flex; align-items: center; gap: 6px; }
  .legend b { font-weight: 400; color: var(--color-bone); }
  .legend__swatch { width: 8px; height: 8px; border-radius: 2px; }

  .chart { display: grid; grid-template-columns: 30px 1fr; grid-template-rows: 180px auto; column-gap: 8px; }
  .chart__y { display: flex; flex-direction: column; justify-content: space-between; font-family: var(--font-mono); font-size: 10px; color: var(--color-mist); text-align: right; margin-block: -6px; }
  .chart__plot { position: relative; }
  .chart__grid { position: absolute; left: 0; right: 0; height: 1px; background: var(--color-iron); }
  .chart__limit { position: absolute; left: 0; right: 0; border-top: 1px dashed var(--color-ash); z-index: 1; }
  .chart__limit em {
    position: absolute; right: 0; top: -18px; font-style: normal;
    font-family: var(--font-mono); font-size: 10px; color: var(--color-ash);
    background: var(--color-graphite); padding: 0 4px;
  }
  .chart__bars { position: absolute; inset: 0; display: flex; align-items: flex-end; gap: 4px; }
  .chart__group { flex: 1; height: 100%; display: flex; align-items: flex-end; justify-content: center; gap: 1.5px; }
  .chart__group i { width: 100%; max-width: 6px; border-radius: 2px 2px 0 0; }
  .chart__x { grid-column: 2; display: flex; justify-content: space-between; padding-top: 8px; font-family: var(--font-mono); font-size: 10px; color: var(--color-mist); }

  .tl { position: relative; display: flex; flex-direction: column; gap: 12px; }
  .tl::before { content: ''; position: absolute; left: 9px; top: 6px; bottom: 6px; width: 1px; background: var(--color-slate-edge); }
  .tl__item { position: relative; display: grid; grid-template-columns: 18px 1fr; column-gap: 10px; row-gap: 2px; }
  .tl__dot { grid-row: span 2; width: 18px; height: 18px; display: grid; place-items: center; background: var(--color-graphite); }
  .tl__time { font-family: var(--font-mono); font-size: 10.5px; color: var(--color-ash); }
  .tl__what { grid-column: 2; font-size: 12.5px; }

  .table-scroll { overflow-x: auto; }
  .mon { width: 100%; border-collapse: collapse; min-width: 680px; }
  .mon th {
    text-align: left; font-weight: 400; padding: 8px 14px;
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ash);
  }
  .mon td { padding: 10px 14px; border-top: 1px solid var(--color-iron); vertical-align: middle; }
  .mon .num { text-align: right; font-family: var(--font-mono); font-size: 12px; white-space: nowrap; }
  .mon__name { display: block; font-weight: 500; }
  .mon__url { display: block; font-family: var(--font-mono); font-size: 11px; color: var(--color-ash); }
  .bars { display: flex; gap: 2px; height: 22px; align-items: flex-end; }
  .bar { flex: 1; min-width: 2px; height: 100%; border-radius: 1px; background: var(--color-slate-edge); }
  .bar--degraded { background: var(--status-degraded); height: 65%; }
  .bar--down { background: var(--status-down); height: 40%; }

  @media (max-width: 1080px) {
    .dash { grid-template-columns: 1fr; }
    .dash__side { display: none; }
    .dash__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .dash__kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .chart__group { gap: 1px; }
    .chart__bars { gap: 2px; }
  }
</style>
