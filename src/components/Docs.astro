---
import Icon from './ui/Icon.astro';
import { sdkSnippets, otelSnippet } from '../data/content';

const guides = [
  { href: '/docs/inicio-rapido', title: 'Início rápido', text: 'Primeiro monitor e primeiro alerta' },
  { href: '/docs/opentelemetry', title: 'OpenTelemetry', text: 'Enviar logs, métricas e traces' },
  { href: '/docs/api', title: 'API REST', text: 'Criar monitores via código e CI' },
];
---
<section id="docs" class="section docs" aria-labelledby="docs-title">
  <div class="container docs__grid">
    <div class="docs__copy">
      <p class="t-eyebrow">Documentação</p>
      <h2 id="docs-title" class="t-heading-lg">Cinco linhas para começar a ver os erros.</h2>
      <p class="t-body">
        Cada recurso tem guia passo a passo, referência de API e exemplo copiável. A documentação é parte do
        produto: se um passo não está claro, tratamos como bug.
      </p>
      <ul class="guides">
        {guides.map((g) => (
          <li>
            <a href={g.href}>
              <span class="guides__text">
                <span class="guides__title">{g.title}</span>
                <span class="guides__desc">{g.text}</span>
              </span>
              <Icon name="arrow" size={18} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="code card" data-tabs>
      <div class="code__bar">
        <div class="code__tabs" role="tablist" aria-label="Linguagem do SDK">
          {sdkSnippets.map((s, i) => (
            <button
              role="tab"
              type="button"
              id={`code-tab-${s.id}`}
              aria-controls={`code-panel-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {s.label}
            </button>
          ))}
        </div>
      </div>

      {sdkSnippets.map((s, i) => (
        <div
          role="tabpanel"
          id={`code-panel-${s.id}`}
          aria-labelledby={`code-tab-${s.id}`}
          hidden={i !== 0}
          class="code__panel"
          tabindex="0"
        >
          <div class="code__install">
            <code><span aria-hidden="true" class="t-muted">$ </span>{s.install}</code>
            <button type="button" class="code__copy" data-copy={s.install}>Copiar</button>
          </div>
          <div class="code__file">{s.file}</div>
          <pre><code>{s.code}</code></pre>
        </div>
      ))}

      <div class="code__otel">
        <div class="code__file">.env</div>
        <pre><code>{otelSnippet}</code></pre>
      </div>
    </div>
  </div>
</section>

<script>
  import { initTabs, initCopyButtons } from '../scripts/tabs';
  initTabs();
  initCopyButtons();
</script>

<style>
  .docs__grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .docs__copy { display: flex; flex-direction: column; gap: var(--spacing-24); position: sticky; top: 104px; }

  .guides { display: flex; flex-direction: column; gap: 8px; margin-top: var(--spacing-8); }
  .guides a {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 14px 16px; border: 1px solid var(--color-iron); border-radius: var(--radius-cards);
    background: var(--surface-card);
    transition: border-color 0.15s ease;
  }
  .guides a:hover { border-color: var(--color-smoke); }
  .guides a:hover :global(svg) { color: var(--color-soft-indigo); transform: translateX(2px); }
  .guides :global(svg) { color: var(--color-ash); transition: transform 0.15s ease; flex: none; }
  .guides__text { display: flex; flex-direction: column; }
  .guides__title { font-weight: 500; }
  .guides__desc { font-size: var(--text-body-sm); color: var(--color-ash); }

  .code { overflow: hidden; background: var(--color-pure-black); border-color: var(--color-slate-edge); }
  .code__bar { padding: 8px; border-bottom: 1px solid var(--color-iron); background: var(--color-carbon); }
  .code__tabs { display: flex; gap: 2px; overflow-x: auto; }
  .code__tabs [role='tab'] {
    min-height: 36px; padding: 0 14px; border: 0; border-radius: 6px;
    background: none; color: var(--color-ash); font-size: var(--text-body-sm); font-weight: 500; letter-spacing: 0; cursor: pointer;
  }
  .code__tabs [role='tab']:hover { color: var(--color-bone); }
  .code__tabs [role='tab'][aria-selected='true'] { background: var(--color-iron); color: var(--color-bone); }

  .code__panel:focus-visible { outline-offset: -4px; }
  .code__install {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    margin: 16px 16px 0; padding: 6px 6px 6px 12px;
    border: 1px solid var(--color-iron); border-radius: 8px; background: var(--color-graphite);
    font-size: 13px; overflow-x: auto;
  }
  .code__install code { white-space: nowrap; }
  .code__copy {
    min-height: 32px; padding: 0 12px; border: 1px solid var(--color-smoke); border-radius: 6px;
    background: none; font-size: 12px; font-weight: 500; cursor: pointer; flex: none;
  }
  .code__copy:hover { background: var(--color-iron); }
  .code__file { padding: 16px 16px 0; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-mist); }
  .code pre { margin: 0; padding: 10px 16px 20px; overflow-x: auto; font-size: 13px; line-height: 1.7; color: #e6e6e6; tab-size: 2; }
  .code__otel { border-top: 1px solid var(--color-iron); background: var(--color-carbon); }

  @media (max-width: 960px) {
    .docs__grid { grid-template-columns: 1fr; }
    .docs__copy { position: static; }
  }
</style>
