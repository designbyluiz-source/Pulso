---
import { setupSteps } from '../data/content';
---
<section class="section setup" aria-labelledby="setup-title">
  <div class="container">
    <div class="setup__head">
      <h2 id="setup-title" class="t-heading-lg">Do cadastro ao primeiro alerta em menos de dois minutos.</h2>
      <p class="t-lead">Sem agente para instalar e sem YAML. Você cola um endereço e o Pulso começa a checar de três continentes.</p>
    </div>

    <ol class="steps">
      {setupSteps.map((s, i) => (
        <li class="step">
          <span class="step__n" aria-hidden="true">{i + 1}</span>
          <h3 class="t-heading-2xs">{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="setup__demo" aria-hidden="true">
      <div class="field">
        <span class="field__label">URL</span>
        <span class="field__value">https://api.loja.com.br/health</span>
      </div>
      <div class="field">
        <span class="field__label">Avisar em</span>
        <span class="field__chips"><span>E-mail</span><span>Slack #plantao</span></span>
      </div>
      <div class="toast">
        <svg width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#3ecf8e" /><path d="M4.8 8.2l2.1 2.1 4.3-4.6" stroke="#000" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Alerta de teste entregue no Slack em 1,8 s
      </div>
    </div>
  </div>
</section>

<style>
  .setup__head {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 60px);
    align-items: end;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-36);
    margin-top: var(--spacing-60);
    counter-reset: step;
  }
  .step { display: flex; flex-direction: column; gap: var(--spacing-12); padding-top: var(--spacing-24); border-top: 1px solid var(--line-strong); }
  .step__n { font-size: var(--text-heading-sm); letter-spacing: -0.04em; line-height: 1; color: var(--color-electric-iris); }
  .step p { color: var(--color-silver-mist); max-width: 38ch; }

  .setup__demo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-12);
    margin-top: var(--spacing-60);
    padding: var(--spacing-18);
    border: 1px solid var(--line);
    border-radius: var(--radius-3xl);
    background: var(--surface-1);
    font-size: 14px;
    font-weight: 400;
  }
  .field { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 14px; min-width: 0; }
  .field:first-child { flex: 1 1 320px; }
  .field__label { color: var(--color-ash-gray); font-size: 12px; }
  .field__value { font-family: var(--font-mono); font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .field__chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .field__chips span { padding: 3px 10px; border-radius: var(--radius-full); background: var(--surface-2); font-size: 13px; }
  .toast { display: inline-flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 14px; background: rgba(62, 207, 142, 0.1); color: var(--status-up); }

  @media (max-width: 860px) {
    .setup__head, .steps { grid-template-columns: 1fr; }
    .steps { gap: var(--spacing-30); }
  }
</style>
