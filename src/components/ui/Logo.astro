---
interface Props { href?: string; }
const { href = '/' } = Astro.props;
---
<a href={href} class="logo" aria-label="Pulso, página inicial">
  <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="0.5" y="0.5" width="23" height="23" rx="6" fill="#141414" stroke="#313131" />
    <path d="M4 12.5h3.5l2.2-5.5 3.6 10.5 2.2-5h4.5" fill="none" stroke="#6798ff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span>Pulso</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
</style>
