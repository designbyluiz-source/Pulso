---
interface Props { href?: string; }
const { href = '/' } = Astro.props;
---
<a href={href} class="logo" aria-label="Pulso, página inicial">
  <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#8052ff" />
        <stop offset="1" stop-color="#15846e" />
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="8" fill="url(#logo-g)" />
    <path d="M5 17h5l3-8 5 15 3-7h6" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span>Pulso</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    min-height: 44px;
  }
</style>
