---
import StatusIcon, { type Status } from './StatusIcon.astro';
interface Props { status: Status; label?: string; }
const labels: Record<Status, string> = {
  up: 'Operacional',
  degraded: 'Lento',
  down: 'Fora do ar',
};
const { status, label = labels[status] } = Astro.props;
---
<span class="badge">
  <StatusIcon status={status} size={12} />
  <span>{label}</span>
</span>

<style>
  /* Cor só no ícone; o texto fica no tom neutro do sistema */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px 3px 6px;
    border-radius: var(--radius-tags);
    background: var(--color-iron);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--color-bone);
    white-space: nowrap;
  }
</style>
