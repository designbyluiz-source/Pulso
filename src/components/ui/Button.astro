---
/**
 * primary: branco sólido, a ação de maior ênfase.
 * ghost: transparente com borda Smoke; sempre ao lado do primary no mesmo grupo.
 * Estilos em global.css (.btn, .btn--primary, .btn--ghost).
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost';
  type?: 'button' | 'submit';
  class?: string;
}
const { href, variant = 'primary', type = 'button', class: className } = Astro.props;
---
{href ? (
  <a href={href} class:list={['btn', `btn--${variant}`, className]}><slot /></a>
) : (
  <button type={type} class:list={['btn', `btn--${variant}`, className]}><slot /></button>
)}
