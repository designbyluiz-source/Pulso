---
import Icon from './ui/Icon.astro';
import { plans } from '../data/content';
---
<section id="precos" class="section pricing grid-bg" aria-labelledby="pricing-title">
  <div class="container">
    <div class="section-head">
      <p class="t-eyebrow">Preços</p>
      <h2 id="pricing-title" class="t-display-sm">Comece grátis. Pague quando o produto crescer.</h2>
      <p>Preços em reais, cobrança mensal e cancelamento a qualquer momento pelo painel.</p>
    </div>

    <ul class="plans">
      {plans.map((p) => (
        <li class:list={['plan card', { 'plan--featured': p.featured }]}>
          <div class="plan__head">
            <h3 class="plan__name">{p.name}</h3>
            {p.featured && <span class="tag tag--accent">Mais escolhido</span>}
          </div>
          <p class="plan__summary">{p.summary}</p>
          <p class="plan__price">
            <span class="plan__amount">{p.price}</span>
            <span class="plan__period">{p.period}</span>
          </p>
          <a
            href={`/cadastro?plano=${p.name.toLowerCase()}`}
            class:list={['btn plan__cta', p.featured ? 'btn--primary' : 'btn--ghost']}
          >
            {p.cta}
          </a>
          <ul class="plan__features" aria-label={`Inclui no plano ${p.name}`}>
            {p.features.map((f) => (
              <li><Icon name="check" size={16} /><span>{f}</span></li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-16); align-items: stretch; }
  .plan { display: flex; flex-direction: column; gap: var(--spacing-16); padding: var(--spacing-32) var(--card-padding); }
  .plan--featured { background: var(--color-iron); border-color: var(--color-smoke); }
  .plan__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 26px; }
  .plan__name { font-size: var(--text-heading-sm); letter-spacing: -0.012em; }
  .tag--accent { color: var(--color-soft-indigo); background: rgba(103, 152, 255, 0.12); }
  .plan__summary { font-size: var(--text-body-sm); color: var(--color-ash); min-height: 44px; }
  .plan__price { display: flex; align-items: baseline; gap: 6px; padding-top: var(--spacing-8); }
  .plan__amount { font-size: var(--text-heading-lg); font-weight: 500; letter-spacing: -0.025em; line-height: 1; }
  .plan__period { font-size: var(--text-body-sm); color: var(--color-ash); }
  .plan__cta { width: 100%; margin-top: var(--spacing-8); }
  .plan__features {
    display: flex; flex-direction: column; gap: 10px;
    margin-top: var(--spacing-8); padding-top: var(--spacing-24); border-top: 1px solid var(--color-slate-edge);
    font-size: var(--text-body-sm);
  }
  .plan__features li { display: flex; gap: 10px; align-items: flex-start; }
  .plan__features :global(svg) { color: var(--color-soft-indigo); flex: none; margin-top: 2px; }

  @media (max-width: 960px) {
    .plans { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
    .plan__summary { min-height: 0; }
  }
</style>
