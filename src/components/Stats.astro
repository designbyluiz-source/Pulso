---
import Icon from './ui/Icon.astro';
import { stats, integrations } from '../data/content';
---
<section class="stats" aria-labelledby="stats-title">
  <div class="container">
    <h2 id="stats-title" class="visually-hidden">O Pulso em números</h2>
    <ul class="stats__grid">
      {stats.map((s) => (
        <li class="stat">
          <Icon name={s.icon} size={24} class="stat__icon" />
          <span class="stat__value">{s.value}</span>
          <span class="stat__label">{s.label}</span>
          <p class="stat__text">{s.text}</p>
        </li>
      ))}
    </ul>

    <div class="works">
      <p class="t-eyebrow">Funciona com o que você já usa</p>
      <ul class="works__list">
        {integrations.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .stats { padding-block: var(--spacing-64) var(--section-gap); }
  .stats__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-32); }
  .stat {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px;
    padding: var(--spacing-24) var(--spacing-16);
  }
  .stat :global(.stat__icon) { color: var(--color-soft-indigo); margin-bottom: 8px; }
  .stat__value { font-size: var(--text-heading-lg); font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; }
  .stat__label { font-size: var(--text-body); font-weight: 500; }
  .stat__text { font-size: var(--text-body-sm); line-height: 1.57; color: var(--color-ash); max-width: 32ch; }

  .works {
    display: flex; flex-direction: column; align-items: center; gap: var(--spacing-24);
    margin-top: var(--spacing-64); padding-top: var(--spacing-40);
    border-top: 1px solid var(--color-iron);
  }
  .works__list {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 40px;
    font-size: 18px; font-weight: 600; letter-spacing: -0.02em; color: var(--color-ash);
  }

  @media (max-width: 760px) {
    .stats__grid { grid-template-columns: 1fr; gap: 0; }
    .stat + .stat { border-top: 1px solid var(--color-iron); }
    .works__list { gap: 10px 24px; font-size: 16px; }
  }
</style>
