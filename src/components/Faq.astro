---
import { faq } from '../data/content';
---
<section class="section faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <h2 id="faq-title" class="t-heading">Perguntas frequentes</h2>
    <div class="faq__list">
      {faq.map((item) => (
        <details>
          <summary>
            <span>{item.q}</span>
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(36px, 6vw, 96px); }
  .faq__list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: 18px;
    min-height: 64px; padding: 18px 0; cursor: pointer; list-style: none;
    font-size: 20px; font-weight: 400; letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker { display: none; }
  summary svg { flex: none; transition: transform 0.2s ease; color: var(--color-ash-gray); }
  details[open] summary svg { transform: rotate(45deg); }
  details p { padding: 0 0 22px; color: var(--color-silver-mist); max-width: 62ch; }
  @media (max-width: 860px) { .faq__grid { grid-template-columns: 1fr; } }
</style>
