---
import { faq } from '../data/content';
---
<section class="section faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__head">
      <p class="t-eyebrow">Perguntas frequentes</p>
      <h2 id="faq-title" class="t-heading-lg">O que costumam perguntar antes de começar.</h2>
      <p class="t-body">Não achou sua dúvida? <a href="/contato" class="faq__link">Fale com a gente</a>.</p>
    </div>
    <div class="faq__list">
      {faq.map((item) => (
        <details class="card">
          <summary>
            <span>{item.q}</span>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .faq__head { display: flex; flex-direction: column; gap: var(--spacing-24); }
  .faq__link { color: var(--color-bone); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--color-smoke); }
  .faq__link:hover { color: var(--color-soft-indigo); text-decoration-color: currentColor; }
  .faq__list { display: flex; flex-direction: column; gap: 8px; }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    min-height: 56px; padding: 16px 20px; cursor: pointer; list-style: none;
    font-weight: 500;
  }
  summary::-webkit-details-marker { display: none; }
  summary svg { flex: none; color: var(--color-ash); transition: transform 0.2s ease; }
  details[open] summary svg { transform: rotate(45deg); color: var(--color-soft-indigo); }
  details:hover { border-color: var(--color-slate-edge); }
  details p { padding: 0 20px 20px; color: var(--color-ash); font-size: var(--text-body-sm); line-height: 1.6; max-width: 64ch; }
  @media (max-width: 900px) { .faq__grid { grid-template-columns: 1fr; } }
</style>
