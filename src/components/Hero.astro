---
import Dashboard from './Dashboard.astro';
import Icon from './ui/Icon.astro';
---
<section class="hero grid-bg" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <p class="t-eyebrow">Monitoramento e observabilidade para desenvolvedores</p>
    <h1 id="hero-title" class="t-display hero__title">Saiba que caiu antes do seu cliente.</h1>
    <p class="hero__lead">
      O Pulso checa seus endpoints de São Paulo, dos Estados Unidos e da Europa, confirma a queda entre as
      regiões e avisa o plantão certo. Logs, erros e página de status no mesmo painel.
    </p>
    <div class="btn-group hero__actions">
      <a href="/cadastro" class="btn btn--primary">Começar grátis</a>
      <a href="#docs" class="btn btn--ghost">Ver a documentação</a>
    </div>
    <ul class="hero__facts">
      <li><Icon name="check" size={14} /> 10 monitores grátis</li>
      <li><Icon name="check" size={14} /> Sem cartão de crédito</li>
      <li><Icon name="check" size={14} /> Primeiro alerta em menos de 2 minutos</li>
    </ul>
  </div>

  <div id="produto" class="container hero__product">
    <Dashboard />
  </div>
</section>

<style>
  .hero { padding-top: clamp(56px, 9vw, 112px); padding-bottom: var(--spacing-64); }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-24);
  }
  .hero__title { max-width: 20ch; }
  .hero__lead { max-width: 560px; color: var(--color-ash); font-size: 18px; line-height: 1.5; }
  .hero__actions { justify-content: center; margin-top: var(--spacing-8); }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-ash);
  }
  .hero__facts li { display: inline-flex; align-items: center; gap: 6px; }
  .hero__facts :global(svg) { color: var(--color-soft-indigo); }
  .hero__product { margin-top: var(--spacing-64); }
</style>
