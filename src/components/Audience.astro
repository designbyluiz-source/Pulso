---
import Icon from './ui/Icon.astro';
import { benefits } from '../data/content';
---
<section class="section audience" aria-labelledby="aud-title">
  <div class="container">
    <div class="section-head">
      <p class="t-eyebrow">Para quem desenvolve e para o time</p>
      <h2 id="aud-title" class="t-display-sm">Menos tempo descobrindo. Mais tempo consertando.</h2>
    </div>

    <ul class="aud">
      {benefits.map((b) => (
        <li class="aud__card card">
          <div class="aud__top">
            <Icon name={b.icon} size={20} class="aud__icon" />
            <span class="tag">{b.who}</span>
          </div>
          <h3 class="t-heading-sm">{b.title}</h3>
          <p class="t-body-sm">{b.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .aud { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-16); }
  .aud__card { display: flex; flex-direction: column; gap: 10px; padding: var(--card-padding); }
  .aud__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-16); }
  .aud__card :global(.aud__icon) { color: var(--color-soft-indigo); }
  @media (max-width: 960px) { .aud { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .aud { grid-template-columns: 1fr; } }
</style>
